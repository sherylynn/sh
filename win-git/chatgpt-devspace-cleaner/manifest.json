{
  "manifest_version": 3,
  "name": "ChatGPT DevSpace Card Cleaner",
  "version": "0.1.1",
  "description": "折叠或移除 ChatGPT 网页中的 DevSpace/MCP 工具调用卡片，减少长对话 DOM 开销。",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "DevSpace Card Cleaner",
    "default_icon": {
      "48": "icons/icon.svg"
    },
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-devspace-cleaner@sherylynn.win",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
