@@ -12,9 +12,15 @@ export default class AsyncClipboard {
         this._target = target || null;
 
         this._isAvailable = null;
+        // NEWHOME_EXPLICIT_PASTE: Firefox keyboard/right-click clipboard bridge.
+        this._explicitPasteShortcut = false;
 
         this._eventHandlers = {
             'focus': this._handleFocus.bind(this),
+            'paste': this._handlePaste.bind(this),
+            'keydown': this._handlePasteKeyDown.bind(this),
+            'keyup': this._handlePasteKeyUp.bind(this),
+            'contextmenu': this._handleContextMenu.bind(this),
         };
 
         // ===== EVENT HANDLERS =====
@@ -45,6 +51,44 @@ export default class AsyncClipboard {
         }
     }
 
+    _handlePasteKeyDown(event) {
+        if ((event.ctrlKey || event.metaKey) && !event.altKey &&
+            event.key.toLowerCase() === 'v') {
+            this._explicitPasteShortcut = true;
+            // Keyboard's normal handler would send Ctrl/Meta+V before the RFB
+            // clipboard update. Keep the browser's paste action, but stop that
+            // premature remote key event.
+            event.stopImmediatePropagation();
+        }
+    }
+
+    _handlePasteKeyUp(event) {
+        if (this._explicitPasteShortcut && event.key.toLowerCase() === 'v') {
+            event.stopImmediatePropagation();
+            this._explicitPasteShortcut = false;
+        }
+    }
+
+    _handlePaste(event) {
+        const text = event.clipboardData?.getData('text/plain');
+        if (typeof text !== 'string') return;
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        this.onpaste(text, true);
+    }
+
+    async _handleContextMenu() {
+        // Firefox does not expose clipboard-read through the Permissions API,
+        // but permits an explicit read attempt from a user-triggered action.
+        if (!navigator?.clipboard?.readText) return;
+        try {
+            const text = await navigator.clipboard.readText();
+            this.onpaste(text, false);
+        } catch (error) {
+            Log.Warn("Clipboard read on right click failed: ", error);
+        }
+    }
+
     // ===== PUBLIC METHODS =====
 
     writeClipboard(text) {
@@ -57,6 +101,10 @@ export default class AsyncClipboard {
 
     grab() {
         if (!this._target) return;
+        this._target.addEventListener('paste', this._eventHandlers.paste);
+        this._target.addEventListener('keydown', this._eventHandlers.keydown, true);
+        this._target.addEventListener('keyup', this._eventHandlers.keyup, true);
+        this._target.addEventListener('contextmenu', this._eventHandlers.contextmenu);
         this._ensureAvailable()
             .then((isAvailable) => {
                 if (isAvailable) {
@@ -67,6 +115,11 @@ export default class AsyncClipboard {
 
     ungrab() {
         if (!this._target) return;
+        this._target.removeEventListener('paste', this._eventHandlers.paste);
+        this._target.removeEventListener('keydown', this._eventHandlers.keydown, true);
+        this._target.removeEventListener('keyup', this._eventHandlers.keyup, true);
+        this._target.removeEventListener('contextmenu', this._eventHandlers.contextmenu);
         this._target.removeEventListener('focus', this._eventHandlers.focus);
+        this._explicitPasteShortcut = false;
     }
 }
